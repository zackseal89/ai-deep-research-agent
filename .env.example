# ==============================================================================
# Autonomous Deep Research Agent — Environment Configuration
# Forward Deployed AI Architecture (Multi-Provider, Resilient Search & Generative UI)
# ==============================================================================

# Backend Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8123

# Frontend -> Backend AG-UI Connection
LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123

# ------------------------------------------------------------------------------
# LLM Provider Selection: "gemini" | "anthropic" | "openai" | "ollama" | "mock"
# (If unset, auto-detected from whichever API key is present)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini

# 1. Google Gemini (Recommended for high-speed Flash research & 1M+ context)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 3. OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# 4. Ollama / Local Model (Air-gapped on-premise deployments)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# Search Engine & Web Scraper
# ------------------------------------------------------------------------------
# Primary: Tavily Research API (https://app.tavily.com/)
# If empty or quota exceeded, automatically falls back to direct web extraction
TAVILY_API_KEY=
