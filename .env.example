# Meridian local V1
# Copy this file to .env, replace the SEC contact with a monitored address,
# and add real provider credentials only if you want live assistant chat.

SEC_USER_AGENT=MeridianDiligenceDemo contact@example.com
TAVILY_API_KEY=

# Leave blank to auto-detect a configured provider; no model key means fixture mode.
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DILIGENCE_DATA_DIR=
